# CVFL Web Backend - Konfigurace prostředí
PORT=3000
DATABASE_FILE=./cvfl.db
# Copy this file to .env and register the exact redirect URL in Discord OAuth2.
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
OWNER_DISCORD_ID=928288966162141194

# Private HTTPS player snapshot API on the Wispbyte bot. Keep the token server-side.
PLAYER_BOT_API_URL=
PLAYER_BOT_API_TOKEN=
PLAYER_BOT_SYNC_INTERVAL_MS=60000
